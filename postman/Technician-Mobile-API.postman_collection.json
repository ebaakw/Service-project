              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{technician_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"arrived\"\n}"
            },
            "url": "{{base_url}}/api/v1/technician/orders/{{order_id}}/status",
            "description": "When `can_mark_arrived=true`. Sets `status_group=in_progress`. Then add quote items + request payment."
          }
        },
        {
          "name": "Move to waiting customer payment (via status)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{locale}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{technician_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"waiting_customer_payment\"\n}"
            },
            "url": "{{base_url}}/api/v1/technician/orders/{{order_id}}/status",
            "description": "Preferred production path is `POST .../request-payment` (sends invoice). Direct status patch is available when `can_move_to_payment=true` / listed in `allowed_next_statuses`."
          }
        },
        {
          "name": "Complete work (after customer paid → started)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{locale}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{technician_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\"\n}"
            },
            "url": "{{base_url}}/api/v1/technician/orders/{{order_id}}/status",
            "description": "Only from `started` after final invoice paid (`can_complete=true`). Clears queue fields (`queue_position`, `estimated_duration_minutes`, `scheduled_at`)."
          }
        },
        {
          "name": "Cancel order",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{locale}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{technician_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"cancelled\",\n  \"cancellation_reason\": \"Customer unreachable\"\n}"
            },
            "url": "{{base_url}}/api/v1/technician/orders/{{order_id}}/status",
            "description": "Only when `can_cancel=true`. Blocked with 422 while `is_accepting_orders=true` — turn off receiving orders in job-preferences first."
          }
        }
      ]
    },
    {
      "name": "Price list & quote",
      "item": [
        {
          "name": "My company price list",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  const items = j.data || j.price_items || [];",
                  "  if (items[0] && items[0].id) pm.collectionVariables.set('company_price_item_id', String(items[0].id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{locale}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{technician_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/technician/price-list?q=",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "technician",
                "price-list"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "",
                  "description": "Optional search text"
                }
              ]
            }
          }
        },
        {
          "name": "Add item from price list",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const j = pm.response.json();",
                  "  const item = j.item || j.data || j;",
                  "  if (item && item.id) pm.collectionVariables.set('item_id', String(item.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
