      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.collectionVariables.set('technician_token', j.token);",
                  "  if (j.technician && j.technician.id) pm.collectionVariables.set('technician_id', String(j.technician.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{locale}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{technician_email}}\",\n  \"password\": \"{{technician_password}}\"\n}"
            },
            "url": "{{base_url}}/api/v1/technician/login",
            "description": "Real technician account (created from company dashboard).\n\nResponse includes `technician.availability_status`, `is_accepting_orders`, `estimated_job_duration_minutes` (defaults only), queue snapshot fields, and `availability_options` for the account picker."
          }
        },
