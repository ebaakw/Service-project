    {
      "name": "Offers",
      "item": [
        {
          "name": "List order offers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json().data || [];",
                  "  const open = data.find(o => o.status === 'offered') || data[0];",
                  "  if (open && open.id) pm.collectionVariables.set('offer_id', String(open.id));",
                  "  if (open && open.order_id) pm.collectionVariables.set('order_id', String(open.order_id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{locale}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{technician_token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/technician/order-offers",
            "description": "Secondary path (`searching_technician`).\n\nEach offer now includes nested `order` summary:\n- `id`, `order_number`, `status`, `status_group`, `status_group_label`\n- `scheduled_at`, `estimated_duration_minutes`, `queue_position`\n- `customer`, `customer_address`, `service_category`, `company`\n- `custom_problem_text`, `customer_notes`\n\nAccept via `POST .../accept` → order becomes `assigned` + enqueued (`queue_position` + `scheduled_at`)."
          }
        },
        {
          "name": "Accept offer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  if (j.order_id) pm.collectionVariables.set('order_id', String(j.order_id));",
                  "  if (j.data && j.data.id) pm.collectionVariables.set('offer_id', String(j.data.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
