                "key": "Accept-Language",
                "value": "{{locale}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{technician_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"technician_on_way\"\n}"
            },
            "url": "{{base_url}}/api/v1/technician/orders/{{order_id}}/status",
            "description": "When `can_start_trip=true`. Sets `status_group=on_way`."
          }
        },
        {
          "name": "Arrived",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
