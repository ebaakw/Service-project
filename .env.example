# -----------------------------------------------------------------------------
# Local development — safe defaults for debugging. For production, copy
# .env.production.example to .env and follow DEPLOYMENT.md instead.
# -----------------------------------------------------------------------------

APP_NAME=خدمتي
APP_ENV=local
APP_KEY=

# Platform super admin (seeded by PlatformAdminSeeder when you run db:seed / migrate:fresh --seed)
PLATFORM_ADMIN_NAME="Super Admin"
PLATFORM_ADMIN_EMAIL="admin@example.com"
PLATFORM_ADMIN_PHONE=
PLATFORM_ADMIN_PASSWORD="password"
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database — use MySQL in production and shared hosting.
# For quick local setup without MySQL, you may use sqlite instead:
# DB_CONNECTION=sqlite
# (then ensure database/database.sqlite exists; comment DB_* below)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
# If MySQL runs via docker-compose and PHP runs on the host, use the published port (see MYSQL_PUBLISH_PORT in docker-compose; default 33060). For a local MySQL install on 3306, set DB_PORT=3306. Inside the `app` container, compose sets DB_HOST/DB_PORT for the internal network.
DB_PORT=33060
DB_DATABASE=homestead_services
DB_USERNAME=homestead
DB_PASSWORD=secret

# Docker Compose (host ports). phpMyAdmin: http://localhost:${PHPMYADMIN_PUBLISH_PORT:-8081}
# APP_PUBLISH_PORT=8000
# MYSQL_PUBLISH_PORT=33060
# PHPMYADMIN_PUBLISH_PORT=8081
# VITE_PUBLISH_PORT=5173

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# -----------------------------------------------------------------------------
# Queue — use database or redis when workers are running.
# `sync` runs jobs inline (no worker); fine for local unless you test queues.
# -----------------------------------------------------------------------------
QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# Cache — `file` or `database` work without Redis.
# -----------------------------------------------------------------------------
CACHE_STORE=database

FILESYSTEM_DISK=local

MEMCACHED_HOST=127.0.0.1

# -----------------------------------------------------------------------------
# Redis — optional. Leave unused for local dev unless you run Redis.
# For PHP without ext-redis, install predis/predis and set REDIS_CLIENT=predis.
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Laravel Sanctum (SPA + future mobile API tokens)
# Comma-separated hosts that may receive session cookies for same-origin API.
# -----------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

# -----------------------------------------------------------------------------
# Broadcasting / Laravel Reverb (WebSockets) — placeholders only for local.
# Set BROADCAST_CONNECTION=reverb when running `php artisan reverb:start`.
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb

# -----------------------------------------------------------------------------
# Mobile API — fake payment placeholders (pay-inspection / pay-final from apps).
# -----------------------------------------------------------------------------
ORDERS_FAKE_PAYMENT_ENABLED=true
TECHNICIAN_DEMO_LOGIN_ENABLED=true
TECHNICIAN_DEMO_EMAIL=technician-demo@example.test
TECHNICIAN_DEMO_PASSWORD=password

FCM_SERVER_KEY=

REVERB_APP_ID=local-app-id
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
